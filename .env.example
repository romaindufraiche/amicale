# ─────────────────────────────────────────────────────────────
# ADPVO — variables d'environnement
# Copier ce fichier en `.env` (jamais versionné) et renseigner les valeurs.
# ─────────────────────────────────────────────────────────────

# URL publique du site, sans slash final (liens des emails, canonical, sitemap).
APP_URL=http://localhost:3000

# Base PostgreSQL 16+.
DATABASE_URL=postgres://postgres@localhost:5432/amicale

# Faire confiance à l'en-tête X-Forwarded-For (true uniquement derrière
# un reverse proxy maîtrisé : Nginx, Caddy, Traefik, load balancer…).
TRUST_PROXY=false

# ── Emails ───────────────────────────────────────────────────
# Transport : "smtp" (production) ou "outbox" (développement / tests :
# les emails sont écrits en JSON dans le dossier .outbox/).
MAIL_TRANSPORT=outbox
MAIL_FROM="ADPVO <no-reply@example.org>"
# Adresse qui reçoit les messages du formulaire de contact et les
# notifications de nouvelles demandes d'adhésion.
BUREAU_EMAIL=bureau@example.org

# Requis si MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true pour le port 465 (TLS implicite), false pour STARTTLS (587)
SMTP_SECURE=false

# Niveau de logs : debug | info | warn | error
LOG_LEVEL=info

# Connexions simultanées à la base par instance (mettre 3 sur Vercel / serverless).
DB_POOL_MAX=10

# true : site de démonstration (autorise le chargement du jeu de données fictif en production).
DEMO_MODE=false
